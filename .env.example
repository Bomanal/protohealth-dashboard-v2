# Copy to .env.local and fill in. Never commit real values.
# The Python API loads .env.local via python-dotenv.
# Vite exposes VITE_* variables from .env / .env.local to the frontend.

# --- Frontend (Vite) --------------------------------------------------------
# Daily room opened for "call now" outbound calls. Only ?call_id=<uuid> is appended
# (no patient data). Leave empty to queue calls without opening a room.
VITE_DAILY_ROOM_URL=
# WebSocket URL of the FlowManager state monitor (Visualize Inbound page).
VITE_MONITOR_WS_URL=ws://localhost:8765
# Read by vite.config.ts from the *shell* environment (process.env), not from this file:
# VITE_API_BASE_URL=http://localhost:8000
# VITE_DEV_SERVER_PORT=8080

# --- API (FastAPI) ----------------------------------------------------------
# Comma-separated browser origins allowed by CORS ("*" is ignored).
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Database: either a full URL...
DATABASE_URL=
# ...or the individual parts (used only when DATABASE_URL is empty)
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# --- Protocol service (backend repo, src/service) ---------------------------
# The API forwards /svc/* there, adding SERVICE_API_KEY server-side (never exposed to the browser).
PROTOCOL_SERVICE_URL=http://localhost:8100
SERVICE_API_KEY=
